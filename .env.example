# ==============================================================================
# e-DAM IARE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your credentials.
# Never commit .env or .env.local to version control.
# ==============================================================================

# DATABASE (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-id>.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<ep-direct-id>.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# OBJECT STORAGE (Cloudflare R2 - S3 Compatible API)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="edam-iare-media"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# GOOGLE WORKSPACE & APPS SCRIPT AUTOMATION
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/<deployment_id>/exec"
GOOGLE_APPS_SCRIPT_SECRET="your_shared_webhook_secret"
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id"

# Frontend Public Mirrors (Vite Environment)
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/<deployment_id>/exec"
VITE_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID="<deployment_id>"
VITE_GOOGLE_APPS_SCRIPT_API_KEY="your_api_key"

