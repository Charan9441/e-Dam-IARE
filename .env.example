# ==============================================================================
# e-DAM IARE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (local dev) and configure values in Vercel Project Settings.
# Never commit .env, .env.local, or real production credentials to version control.
# Do NOT expose DATABASE_URL, R2 keys, or Apps Script secrets with VITE_ prefixes.
# ==============================================================================

# DATABASE (Neon Serverless PostgreSQL - Server-Side Only)
DATABASE_URL="postgresql://<user>:<password>@<ep-pooler-id>.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<ep-direct-id>.<region>.aws.neon.tech/<db>?sslmode=require"

# OBJECT STORAGE (Cloudflare R2 - S3 Compatible API - Server-Side Only)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_private_r2_bucket_name"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# GOOGLE WORKSPACE & APPS SCRIPT AUTOMATION (Server-Side Only)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/<deployment_id>/exec"
GOOGLE_APPS_SCRIPT_SECRET="your_rotated_shared_webhook_secret"
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id"

# SECURITY & ORIGIN ALLOWLIST
ALLOWED_ORIGINS="https://e-dam-iare.vercel.app"
ADMIN_INITIAL_PASSWORD="replace_only_during_initial_provisioning_min_12_chars"
